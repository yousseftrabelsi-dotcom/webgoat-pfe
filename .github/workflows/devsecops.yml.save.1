  falco-scan:
    needs: [secrets-scan, sast-scan, vulnerability-scan]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
    
      - name: Pull Falco Official Image
        run: docker pull falcosecurity/falco:latest
    
      - name: Run Falco Container + Simulations
        run: |
          # Start Falco monitoring HOST (privileged mounts)
          docker run -d --name falco-monitor \
            --privileged \
            -v /proc:/host/proc:ro \
            -v /sys/kernel/debug:/sys/kernel/debug:ro \
            -v /var/run/docker.sock:/host/var/run/docker.sock \
            -v /etc:/host/etc:ro \
            falcosecurity/falco:latest \
            falco -o json_output=true -o engine.kind=ebpf -o ebpf.probe=modern
        
          sleep 5  # Init
        
          # Simulations → Déclenche alertes
          docker run --rm ubuntu:latest cat /etc/shadow     # Notice shell
          docker run --rm ubuntu:latest touch /etc/malware  # Warning write
          docker run --rm alpine:latest cat /etc/passwd     # Error sensitive
          docker run --rm alpine:latest sh -c "nc -l -p 1234"  # Critical network
        
          sleep 10
        
          # Extract logs → falco-results.json pour dashboard
          docker logs falco-monitor 2>&1 | grep '"output"' > falco-results.json
          echo "Alertes: $(wc -l < falco-results.json)"
          docker rm -f falco-monitor
    
      - name: Upload Falco Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: report-falco
          path: falco-results.json         
  # ═══════════════════════════════════════════════════════════════════
  # PHASE 3a — Analyse IA (lit TOUS les rapports des 5 outils)
  # ═══════════════════════════════════════════════════════════════════

  ai-agent-analysis:
    needs: [dast-scan, falco-scan]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # On télécharge chaque artefact individuellement pour être sûr de les avoir
      - name: Download Trivy report
        uses: actions/download-artifact@v4
        with:
          name: report-trivy
        continue-on-error: true

      - name: Download Gitleaks report
        uses: actions/download-artifact@v4
        with:
          name: report-gitleaks
        continue-on-error: true

      - name: Download ZAP report
        uses: actions/download-artifact@v4
        with:
          name: report-zap
        continue-on-error: true

      - name: Download Falco report
        uses: actions/download-artifact@v4
        with:
          name: report-falco
        continue-on-error: true

      - name: List available reports
        run: ls -lah *.json *.sarif *.html 2>/dev/null || echo "Certains rapports sont manquants."

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install google-genai

      - name: Run AI Agent
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: python scripts/ai_analyzer.py

      - name: Upload AI Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: report-ai
          path: ai-security-summary.txt

  # ═══════════════════════════════════════════════════════════════════
  # PHASE 3b — Génération du Dashboard final
  # ═══════════════════════════════════════════════════════════════════

  generate-dashboard:
    needs: ai-agent-analysis
    if: always()
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write   # Pour commenter une PR si besoin

    steps:
      - uses: actions/checkout@v4

      # Téléchargement de chaque artefact dans un sous-dossier
      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts/
          merge-multiple: true

      - name: Flatten artifacts to working directory
        run: |
          find artifacts/ -type f | while read f; do
            cp "$f" . && echo "Copié : $f"
          done
          echo "=== Fichiers disponibles pour le dashboard ==="
          ls -lah *.json *.sarif *.html *.txt 2>/dev/null || true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Python dependencies
        run: python -m pip install plotly markdown 

      - name: Generate Dashboard
        env:
          GITHUB_SHA:        ${{ github.sha }}
          GITHUB_RUN_NUMBER: ${{ github.run_number }}
          GITHUB_RUN_URL:    ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          GITHUB_REF_NAME:   ${{ github.ref_name }}
          GITHUB_ACTOR:      ${{ github.actor }}
        run: python scripts/generate_dashboard.py

      - name: Upload Final Dashboard
        uses: actions/upload-artifact@v4
        with:
          name: DevSecOps-Final-Dashboard
          path: global_security_report.html
          retention-days: 30
